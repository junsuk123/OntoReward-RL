  "forbidden_sources": [
    "future", "reward", "episode_outcome", "scenario_id", "programmed_ugv_speed",
    "simulator_truth", "ground_truth", "true_relative_state", "critic",
    "platform_position", "platform_velocity", "pad_position", "pad_velocity",
    "geometric_fov_label", "teacher_action", "pn_action", "after_action"
  ]
}
