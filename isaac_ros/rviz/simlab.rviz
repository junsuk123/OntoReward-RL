Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: [/Global Options1, /TF1, /Tracked Drones1]
    Splitter Ratio: 0.5
    Tree Height: 680
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Arena Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 24
      Color: 120; 120; 125
      Alpha: 0.45
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 3
      Marker Scale: 0.6
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Tree: {}
    - Class: rviz_default_plugins/MarkerArray
      Name: Tracked Drones
      Enabled: true
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /simlab/tracking/markers
    - Class: rviz_default_plugins/Image
      Name: Front Near YOLO
      Enabled: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /simlab/front_near/detections
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Front Far YOLO
      Enabled: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /simlab/front_far/detections
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Satellite Nadir RGB
      Enabled: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /simlab/satellite_nadir/image
      Normalize Range: true
  Global Options:
    Background Color: 32; 34; 38
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Swarm Overview
      Distance: 21
      Focal Point:
        X: 0
        Y: 0
        Z: 2.5
      Pitch: 0.75
      Yaw: 0.8
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 950
  Width: 1650
  Displays:
    collapsed: false
  Views:
    collapsed: false
